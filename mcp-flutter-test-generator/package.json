{
  "name": "mcp-flutter-test-generator",
  "version": "1.0.0",
  "description": "MCP server for generating Flutter Patrol tests at runtime",
  "main": "build/index.js",
  "type": "module",
  "bin": {
    "mcp-flutter-test-generator": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "clean": "rm -rf build",
    "rebuild": "npm run clean && npm run build"
  },
  "keywords": ["mcp", "flutter", "dart", "test", "patrol"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}